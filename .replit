modules = ["c-clang14", "cpp-clang14", "nodejs-20"]
run = "node index.js"

[nix]
channel = "stable-25_05"
packages = ["cairo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "libxcrypt", "libyaml", "pkg-config", "python312Packages.pip", "qhull", "tcl", "tk", "xsimd", "cmake"]

[deployment]
run = ["sh", "-c", "node index.js"]

[workflows]
runButton = "NiFi System"

[[workflows.workflow]]
name = "SkinTwin System"
author = 39128348
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python agi-skintwin/main.py --demo"

[[workflows.workflow]]
name = "KoboldCpp Server"
author = 39128348
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd kobold-cpp && python scripts/run_koboldcpp.py --model /path/to/model.gguf --port 5001"

[[workflows.workflow]]
name = "NiFi System"
author = 39128348
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install -r nifi/requirements.txt"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python nifi/main.py --port 8080"

[[workflows.workflow]]
name = "AI/ML Integration Demo"
author = 39128348
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python examples/ai_ml_integration_demo.py"

[agent]
expertMode = true
